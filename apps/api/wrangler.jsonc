{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cross-border-ad-agent-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },

  // Secret binding name only. Supply SESSION_PEPPER through .dev.vars locally
  // and `wrangler secret put SESSION_PEPPER --env preview` for preview.
  "vars": {
    "APP_ENV": "local",
    "VIDEO_GENERATION_PROVIDER": "minimax",
    "MINIMAX_BASE_URL": "https://api.minimaxi.com",
    "MINIMAX_MODEL_ID": "MiniMax-H3",
    "SEEDANCE_MODEL_ID": "doubao-seedance-2-5-260628",
    "DECLARED_D1_DATABASE_NAME": "cross-border-ad-agent-local-db",
    "DECLARED_R2_BUCKET_NAME": "cross-border-ad-agent-local-media"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cross-border-ad-agent-local-db",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "cross-border-ad-agent-local-media"
    }
  ],

  "env": {
    "preview": {
      "name": "cross-border-ad-agent-preview",
      "vars": {
        "APP_ENV": "preview",
        "VIDEO_GENERATION_PROVIDER": "minimax",
        "MINIMAX_BASE_URL": "https://api.minimaxi.com",
        "MINIMAX_MODEL_ID": "MiniMax-H3",
        "SEEDANCE_MODEL_ID": "doubao-seedance-2-5-260628",
        "DECLARED_D1_DATABASE_NAME": "cross-border-ad-agent-preview-db",
        "DECLARED_R2_BUCKET_NAME": "cross-border-ad-agent-preview-media"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cross-border-ad-agent-preview-db",
          "database_id": "preview-d1-id-requires-fresh-approval",
          "migrations_dir": "../../migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "cross-border-ad-agent-preview-media"
        }
      ]
    }
  }
}
